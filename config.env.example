# 逗号分隔的币安公告 catalog。48 上新，49 更新，161 下架。
CATALOGS=48,49,161

# 公开 GET 的间隔秒数，不得低于 1.5。
REQUEST_DELAY_SECONDS=2

# 一轮成功结束后的睡眠秒数。
POLL_INTERVAL_SECONDS=600

# 遇到 HTTP 403 或验证页后的冷却秒数。不要绕过验证。
CHALLENGE_COOLDOWN_SECONDS=21600

# HTTP 代理。留空则直连。
PROXY_URL=

# loadhist 默认读取的 jsonl 目录（binance-announcements-{catalog}.jsonl）。
# 留空时默认导入会失败。要从币安拉取：loadhist --from-binance（会先打印警告）。
JSONL_DIR=

# duckport status 用现在减去 max(release_time) 和这个秒数比较。公告不定期发布。
WATERMARK_MAX_LAG_SECONDS=604800
